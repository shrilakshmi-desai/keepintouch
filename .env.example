# Copy to `.env` and fill in from Supabase → Project Settings → API.
# Use the publishable (anon) key, never the secret / service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Web Push public key (VAPID). Generate a pair; the private half goes in Supabase secrets.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
