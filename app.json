{
  "expo": {
    "name": "KeepInTouch",
    "slug": "KeepInTouch",
    "version": "1.0.0",
    "scheme": "keepintouch",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF7A59"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "KeepInTouch uses your contacts so you can add someone without typing their details."
        }
      ]
    ],
    "backgroundColor": "#FFFBF7"
  }
}
