# Secrets — never commit.
# Note: Expo's default template only ignores `.env*.local`, which would let a
# plain `.env` (our Supabase keys) get committed. These rules are stricter.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Metro
.metro-health-check*

# Native credentials & generated native folders
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
/ios
/android

# TypeScript
*.tsbuildinfo

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Machine-local Claude Code settings
.claude/settings.local.json

# macOS
.DS_Store
